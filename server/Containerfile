# Game server for IBM LinuxONE (s390x). Build context is the repo root.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
# PyPI has no s390x wheels for numpy/pandas/scikit-learn, so take Ubuntu's prebuilt ones.
# libzdnn0 lets Snap ML (M2) run on the on-chip AI accelerator (NNPA).
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip python3-numpy python3-pandas python3-psycopg \
        python3-sklearn python3-scipy libpython3.12t64 libzdnn0 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /venv
ENV PATH=/venv/bin:$PATH

COPY server/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /app
COPY . /app
ENV PYTHONPATH=/app/engine:/app/server
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/app/server"]
